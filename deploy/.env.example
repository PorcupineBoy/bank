# ============================================
# Bank System - Production Environment Config
# ============================================
# 使用方法:
#   1. cp deploy/.env.example deploy/.env
#   2. 修改 deploy/.env 中的值为真实生产环境参数
#   3. bash deploy/deploy.sh

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_db
DB_USER=root
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 应用密钥 ----------
JWT_SECRET=bank-mobile-jwt-secret-key-2026
AES_KEY=bank-mobile-aes-256-secret-key!!

# ---------- 后端 ----------
BACKEND_PORT=8080

# ---------- Nginx ----------
# 部署本机的公网IP或域名
SERVER_NAME=_
# 前端访问端口
NGINX_PORT=80
