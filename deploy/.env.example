# ============================================
# Bank System - Production Environment Config
# ============================================
# 使用方法:
#   1. cp deploy/.env.example deploy/.env
#   2. 修改 deploy/.env 中的值为真实生产环境参数
#   3. bash deploy/deploy.sh
#
# 注意：如果密码或值包含特殊字符（如 ( ) ! $ & 空格 等），
#       必须用双引号括起来，例如：DB_PASSWORD="my(pass)word"
# ============================================

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_db
DB_USER=root
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 应用密钥 ----------
JWT_SECRET="bank-mobile-jwt-secret-key-2026_pass"
AES_KEY="bank-mobile-aes-256-secret-key!!"

# ---------- 后端 ----------
BACKEND_PORT=8080

# ---------- 大模型 LLM ----------
# 当前激活的提供商（openai / deepseek / xiaomi）
LLM_PROVIDER=xiaomi
# OpenAI/DeepSeek 配置
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=5000
# 小米 MiMo 配置
LLM_XIAOMI_API_URL=
LLM_XIAOMI_API_KEY=
LLM_XIAOMI_MODEL=mimo-v2-flash

# 【重要】如果修改 BACKEND_PORT，必须同步修改以下文件的端口：
#   - deploy/nginx/bank.conf 中的 proxy_pass
#   - 你的 cloud.conf 中 location /bank/api/ 的 proxy_pass

# ---------- Nginx ----------
# 部署本机的公网IP或域名
SERVER_NAME=your-domain.com
# 前端访问端口
NGINX_PORT=80
